      "parameters": {
        "jsCode": "const items = $input.all();\nconst valid = [];\n\nfor (const item of items) {\n  const body = item.json.body || item.json;\n  let data = body.data;\n  if (Array.isArray(data)) data = data[0];\n  if (!data) continue;\n\n  if (data.key && data.key.fromMe === true) continue;\n\n  // FORZAMOS A USAR EL REMOTEJID DEL CLIENTE\n  const phone = data.key && data.key.remoteJid ? data.key.remoteJid.split('@')[0] : '';\n  \n  let text = '';\n  if (data.message) {\n    text = data.message.conversation || \n           data.message.extendedTextMessage?.text || \n           data.message.buttonsResponseMessage?.selectedDisplayText || '';\n  }\n  \n  if (text && phone) {\n    valid.push({ json: { text, phone, raw: data } });\n  }\n}\nreturn valid;"
      },
